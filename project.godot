; Jumping Penguin — Godot 4.7.2
config_version=5

[application]
config/name="Jumping Penguin"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Skacz po podniebnych wyspach i zbieraj rybki!"
config/icon="res://assets/art/icon.png"

[autoload]
Progress="*res://scripts/progress.gd"
Sound="*res://scripts/sound.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.78, 0.92, 0.95, 1)

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[audio]
driver/enable_input=false
